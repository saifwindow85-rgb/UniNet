<div class="sbx">
    <svg class="sbx-ic" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" /></svg>
    <input class="sbx-input" value="@_value" @oninput="OnInput" placeholder="@Placeholder" />
    @if (!string.IsNullOrEmpty(_value))
    {
        <button type="button" class="sbx-clear" @onclick="Clear" aria-label="مسح">✕</button>
    }
</div>

@code {
    [Parameter] public string Placeholder { get; set; } = "ابحث بالاسم…";
    [Parameter] public EventCallback<string> OnSearch { get; set; }

    private string _value = "";
    private CancellationTokenSource? _cts;

    private async Task OnInput(ChangeEventArgs e)
    {
        _value = e.Value?.ToString() ?? "";
        _cts?.Cancel();
        _cts = new CancellationTokenSource();
        var token = _cts.Token;
        try { await Task.Delay(400, token); } catch (TaskCanceledException) { return; }
        if (!token.IsCancellationRequested)
            await OnSearch.InvokeAsync(_value.Trim());
    }

    private async Task Clear()
    {
        _value = "";
        _cts?.Cancel();
        await OnSearch.InvokeAsync("");
    }
}
