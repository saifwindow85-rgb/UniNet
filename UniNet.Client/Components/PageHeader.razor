<div class="ph">
    <div class="ph-text">
        <h1>@Title</h1>
        @if (!string.IsNullOrEmpty(Subtitle)) { <p>@Subtitle</p> }
    </div>
    @if (Actions is not null) { <div class="ph-actions">@Actions</div> }
</div>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
}
