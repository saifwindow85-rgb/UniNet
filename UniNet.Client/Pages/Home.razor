@page "/"
@attribute [Authorize]

<PageTitle>الرئيسية · UniNet</PageTitle>

<AuthorizeView>
    <Authorized Context="auth">
        <section class="hero surface">
            <div class="hero-text">
                <span class="eyebrow">لوحة الإدارة</span>
                <h1>مرحبًا، @auth.User.Identity?.Name 👋</h1>
                <p>تم تسجيل دخولك بنجاح. صلاحياتك ونطاقك مقروءان مباشرةً من رمز الدخول (JWT).</p>
            </div>
            <div class="hero-badge">@Role(auth)</div>
        </section>

        <div class="scope-row">
            <div class="scope surface"><span>الجامعة</span><b class="mono">@Claim(auth, "UniversityId")</b></div>
            <div class="scope surface"><span>الكلية</span><b class="mono">@Claim(auth, "CollegeId")</b></div>
            <div class="scope surface"><span>القسم</span><b class="mono">@Claim(auth, "DepartmentId")</b></div>
            <div class="scope surface"><span>الدفعة</span><b class="mono">@Claim(auth, "BatchId")</b></div>
        </div>

        <AuthorizeView Roles="Super Admin" Context="sa">
            <h2 class="section-title">الهوية</h2>
            <div class="cards">
                <a class="qcard surface" href="/identity/roles">
                    <div class="qc-ic teal"><svg viewBox="0 0 24 24"><path d="M12 2 4 5v6c0 5 3.5 8.5 8 11 4.5-2.5 8-6 8-11V5l-8-3Z" /></svg></div>
                    <div class="qc-text"><b>الأدوار</b><span>إنشاء وتعديل أدوار النظام</span></div>
                    <svg class="qc-go" viewBox="0 0 24 24"><path d="M15 6l-6 6 6 6" /></svg>
                </a>
                <a class="qcard surface" href="/identity/users">
                    <div class="qc-ic navy"><svg viewBox="0 0 24 24"><path d="M20 21a8 8 0 1 0-16 0M12 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z" /></svg></div>
                    <div class="qc-text"><b>المستخدمون</b><span>إنشاء المستخدمين وتعديلهم</span></div>
                    <svg class="qc-go" viewBox="0 0 24 24"><path d="M15 6l-6 6 6 6" /></svg>
                </a>
                <a class="qcard surface" href="/identity/user-roles">
                    <div class="qc-ic amber"><svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" /></svg></div>
                    <div class="qc-text"><b>أدوار المستخدمين</b><span>إسناد الأدوار وإزالتها</span></div>
                    <svg class="qc-go" viewBox="0 0 24 24"><path d="M15 6l-6 6 6 6" /></svg>
                </a>
            </div>
        </AuthorizeView>
    </Authorized>
</AuthorizeView>

@code {
    private static string Claim(AuthenticationState s, string type) =>
        s.User.FindFirst(type)?.Value ?? "—";

    private static string Role(AuthenticationState s) =>
        s.User.FindFirst("http://schemas.microsoft.com/ws/2008/06/identity/claims/role")?.Value
        ?? s.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "مستخدم";
}

<style>
    .hero { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; padding: 1.75rem; margin-bottom: 1.25rem; background: linear-gradient(120deg, #fff 60%, #f0fbfa); flex-wrap: wrap; }
    .hero .eyebrow { font-family: "Inter",sans-serif; font-size: .72rem; letter-spacing: .12em; text-transform: uppercase; color: var(--teal-strong); font-weight: 700; }
    .hero h1 { margin: .35rem 0 .4rem; font-size: 1.65rem; }
    .hero p { margin: 0; color: var(--muted); max-width: 60ch; }
    .hero-badge { padding: .5rem 1rem; border-radius: 99px; font-weight: 600; color: #052a2a; background: linear-gradient(135deg,#2ee6d1,var(--teal-strong)); white-space: nowrap; }

    .scope-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(130px,1fr)); gap: .8rem; margin-bottom: 1.75rem; }
    .scope { padding: .9rem 1.1rem; display: flex; flex-direction: column; gap: .3rem; }
    .scope span { font-size: .74rem; color: var(--muted); font-family: "Inter",sans-serif; }
    .scope b { font-size: 1.2rem; color: var(--navy-700); }

    .section-title { font-size: 1.05rem; margin: 0 0 .9rem; color: var(--ink); }
    .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px,1fr)); gap: 1rem; }
    .qcard { display: flex; align-items: center; gap: .9rem; padding: 1.1rem; text-decoration: none; color: inherit; transition: transform .12s ease, box-shadow .18s ease, border-color .18s ease; }
    .qcard:hover { transform: translateY(-2px); box-shadow: var(--shadow); border-color: #d7e4ef; }
    .qc-ic { display: grid; place-items: center; width: 46px; height: 46px; border-radius: 13px; flex: none; }
    .qc-ic svg { width: 23px; height: 23px; fill: none; stroke: #fff; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
    .qc-ic.teal { background: linear-gradient(140deg,#2ee6d1,var(--teal-strong)); }
    .qc-ic.navy { background: linear-gradient(140deg,var(--navy-700),var(--navy-900)); }
    .qc-ic.amber { background: linear-gradient(140deg,#f6b64b,#e08a1e); }
    .qc-text { flex: 1; display: flex; flex-direction: column; }
    .qc-text b { font-size: 1rem; }
    .qc-text span { font-size: .84rem; color: var(--muted); }
    .qc-go { width: 20px; height: 20px; fill: none; stroke: #c2cfdc; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
</style>
