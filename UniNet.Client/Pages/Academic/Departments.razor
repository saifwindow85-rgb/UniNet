@page "/academic/departments"
@attribute [Authorize(Roles = "Super Admin,UniversityAdmin,CollegeAdmin")]
@using System.ComponentModel.DataAnnotations
@inject DepartmentApiService DepartmentsApi
@inject CollegeApiService CollegesApi
@inject ScopeLookups Lookups
@inject ScopeContext Scope

<PageTitle>الأقسام · UniNet</PageTitle>

<PageHeader Title="الأقسام" Subtitle="إدارة أقسام الكلية ضمن نطاقك.">
    <Actions>
        <button class="btn btn-primary" @onclick="OpenAdd">
            <svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" /></svg>
            قسم جديد
        </button>
    </Actions>
</PageHeader>

<Alert Message="@_notice" Kind="@_noticeKind" OnClose="() => _notice = null" />

<div class="toolbar">
    <SearchBox Placeholder="ابحث باسم القسم…" OnSearch="OnSearch" />
    @if (Scope.CollegeId is not null)
    {
        <div class="ctx-field">
            <span class="ctx-lbl">الكلية</span>
            <input class="inp" value="@_scopeCollegeName" disabled />
        </div>
    }
    else
    {
        <div style="min-width:300px">
            <Combobox Items="_collegeItems" Value="_filterCollegeId" ValueChanged="OnFilterCollege"
                      Loading="_collegesLoading" Placeholder="تصفية حسب الكلية (الكل)" />
        </div>
    }
</div>

@if (_loading)
{
    <div class="loading"><span class="spin"></span></div>
}
else if (_items is { Count: > 0 })
{
    <div class="table-wrap">
        <table class="data">
            <thead>
                <tr><th style="width:90px">المعرّف</th><th>القسم</th><th style="width:150px"></th></tr>
            </thead>
            <tbody>
                @foreach (var d in _items)
                {
                    <tr>
                        <td><span class="badge badge-id">#@d.DepartmentId</span></td>
                        <td><strong>@d.DepartmentName</strong>@if (!string.IsNullOrEmpty(d.Description)) { <div class="row-sub">@d.Description</div> }</td>
                        <td class="actions">
                            <button class="btn btn-ghost btn-sm" @onclick="() => OpenEdit(d)">تعديل</button>
                            <button class="btn btn-danger btn-sm" @onclick="() => _deleteTarget = d">حذف</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <Pager Current="_page" TotalPages="_totalPages" Total="_total" CurrentChanged="ChangePage" />
}
else
{
    <div class="surface empty">
        <svg viewBox="0 0 24 24"><path d="M4 4h16v16H4zM4 10h16M10 10v10" /></svg>
        <p>لا توجد أقسام ضمن نطاقك بعد.</p>
    </div>
}

<Modal Visible="_formOpen" MaxWidth="520px"
       Title="@(_editing is null ? "قسم جديد" : "تعديل القسم")"
       Subtitle="@(_editing is null ? "أضِف قسمًا إلى الكلية." : $"تعديل القسم #{_editing.DepartmentId}")"
       OnClose="CloseForm">
    <ChildContent>
        <Alert Message="@_formError" Kind="err" OnClose="() => _formError = null" />
        <EditForm Model="_form" OnValidSubmit="SaveAsync" id="deptForm">
            <DataAnnotationsValidator />
            <div class="form-grid">
                @if (_editing is null)
                {
                    <div class="form-row">
                        <label class="lbl">الكلية <span class="req">*</span></label>
                        @if (Scope.CollegeId is not null)
                        {
                            <input class="inp" value="@_scopeCollegeName" disabled />
                            <span class="hint-inline">كليتك — تُمرَّر تلقائيًا.</span>
                        }
                        else
                        {
                            <Combobox Items="_collegeItems" Value="_form.CollegeId" ValueChanged="v => _form.CollegeId = v"
                                      Loading="_collegesLoading" Placeholder="ابحث واختر الكلية" Disabled="@_saving" />
                        }
                    </div>
                }
                else
                {
                    <div class="form-row">
                        <label class="lbl">الكلية</label>
                        <input class="inp" value="—" disabled />
                        <span class="hint-inline">لا يمكن نقل القسم بين الكليات.</span>
                    </div>
                }

                <div class="form-row">
                    <label class="lbl">اسم القسم <span class="req">*</span></label>
                    <InputText class="inp" @bind-Value="_form.DepartmentName" placeholder="مثال: هندسة البرمجيات" disabled="@_saving" />
                    <ValidationMessage For="() => _form.DepartmentName" />
                </div>

                <div class="form-row">
                    <label class="lbl">الوصف</label>
                    <InputTextArea class="inp txt" @bind-Value="_form.Description" rows="3" disabled="@_saving" />
                </div>
            </div>
        </EditForm>
    </ChildContent>
    <Footer>
        <button class="btn btn-ghost" @onclick="CloseForm" disabled="@_saving">إلغاء</button>
        <button class="btn btn-primary" type="submit" form="deptForm" disabled="@_saving">
            @if (_saving) { <span class="spin-btn"></span> }
            @(_editing is null ? "إضافة" : "حفظ")
        </button>
    </Footer>
</Modal>

<ConfirmDialog Visible="_deleteTarget is not null"
               Subtitle="@(_deleteTarget is null ? null : $"القسم #{_deleteTarget.DepartmentId}")"
               Message="@($"سيُحذف «{_deleteTarget?.DepartmentName}». لا يمكن الحذف إن كانت له دفعات.")"
               Busy="_deleting" OnConfirm="DeleteAsync" OnCancel="() => _deleteTarget = null" />

@code {
    private List<DepartmentDTO>? _items;
    private bool _loading = true;
    private int _page = 1, _pageSize = 10, _totalPages = 1, _total;
    private string _search = "";
    private string? _formError;

    private List<Combobox.ComboItem> _collegeItems = new();
    private bool _collegesLoading;
    private int _filterCollegeId;
    private string _scopeCollegeName = "—";

    private bool _formOpen, _saving;
    private DepartmentDTO? _editing;
    private readonly DeptForm _form = new();

    private DepartmentDTO? _deleteTarget;
    private bool _deleting;

    private string? _notice;
    private string _noticeKind = "ok";

    protected override async Task OnInitializedAsync()
    {
        await Scope.EnsureAsync();

        if (Scope.CollegeId is int cid)
        {
            // CollegeAdmin: الكلية مثبّتة.
            var c = await CollegesApi.GetByIdAsync(cid);
            if (c.Success && c.Data is not null) _scopeCollegeName = c.Data.CollegeName;
        }
        else
        {
            // UA/SA: قائمة كليات للـ combobox والتصفية.
            await LoadCollegesAsync();
        }

        await LoadAsync();
    }

    private async Task LoadCollegesAsync()
    {
        _collegesLoading = true;
        var res = await CollegesApi.GetPerUniversityAsync(null, 1, 200); // scope-aware
        if (res.Success && res.Data?.Data is not null)
            _collegeItems = res.Data.Data
                .Select(c => new Combobox.ComboItem(c.CollegeId, c.CollegeName, Scope.IsSuperAdmin ? c.UniversityName : null))
                .ToList();
        _collegesLoading = false;
    }

    private List<DepartmentDTO> _allScoped = new(); // UA: كل أقسام الجامعة (مُجمّعة) للتصفّح المحلّي

    private async Task LoadAsync()
    {
        _loading = true;

        // UniversityAdmin بلا فلتر كلية: الـ endpoint يقصر على كلية واحدة — نجمع كل أقسام الجامعة ونصفّحها محليًا.
        if (!Scope.IsSuperAdmin && Scope.CollegeId is null && Scope.UniversityId is not null && _filterCollegeId <= 0)
        {
            if (_allScoped.Count == 0) _allScoped = await Lookups.DepartmentsAsync();
            var filtered = string.IsNullOrWhiteSpace(_search)
                ? _allScoped
                : _allScoped.Where(d => d.DepartmentName.Contains(_search, StringComparison.OrdinalIgnoreCase)).ToList();
            _total = filtered.Count;
            _totalPages = Math.Max(1, (int)Math.Ceiling(_total / (double)_pageSize));
            _page = Math.Min(_page, _totalPages);
            _items = filtered.Skip((_page - 1) * _pageSize).Take(_pageSize).ToList();
            _loading = false;
            return;
        }

        ApiResult<Contracts.Results.PagedResult<DepartmentDTO>> res;
        if (Scope.IsSuperAdmin && _filterCollegeId <= 0)
            res = await DepartmentsApi.GetAllAsync(_page, _pageSize, _search);
        else
            res = await DepartmentsApi.GetPerCollegeAsync(_filterCollegeId, _page, _pageSize, _search);

        if (res.Success && res.Data is not null)
        {
            _items = res.Data.Data ?? new();
            _totalPages = Math.Max(1, res.Data.TotalPages);
            _total = res.Data.TotalRecords;
        }
        else { _items = new(); Notify(res.Error ?? "تعذّر جلب الأقسام.", "err"); }
        _loading = false;
    }

    private async Task OnFilterCollege(int cid) { _filterCollegeId = cid; _page = 1; await LoadAsync(); }
    private async Task OnSearch(string term) { _search = term; _page = 1; await LoadAsync(); }
    private async Task ChangePage(int p) { _page = p; await LoadAsync(); }

    private void OpenAdd()
    {
        _editing = null;
        _form.Reset();
        _formError = null;
        if (Scope.CollegeId is int cid) _form.CollegeId = cid; // تمرير تلقائي للـ CA
        _formOpen = true;
    }

    private void OpenEdit(DepartmentDTO d)
    {
        _editing = d;
        _form.DepartmentName = d.DepartmentName;
        _form.Description = d.Description;
        _formError = null;
        _formOpen = true;
    }

    private void CloseForm() { _formOpen = false; _saving = false; _formError = null; }

    private async Task SaveAsync()
    {
        if (_editing is null && _form.CollegeId <= 0) { Notify("اختر الكلية.", "err"); return; }
        _saving = true;

        ApiResult<DepartmentDTO> res;
        if (_editing is null)
        {
            res = await DepartmentsApi.AddAsync(new AddDepartmentDTO
            {
                CollegeId = _form.CollegeId,
                DepartmentName = _form.DepartmentName.Trim(),
                Description = string.IsNullOrWhiteSpace(_form.Description) ? null : _form.Description!.Trim()
            });
        }
        else
        {
            res = await DepartmentsApi.UpdateAsync(_editing.DepartmentId, new UpdateDepartmentDTO
            {
                DepartmentName = _form.DepartmentName.Trim(),
                Description = string.IsNullOrWhiteSpace(_form.Description) ? null : _form.Description!.Trim()
            });
        }

        _saving = false;
        if (res.Success) { CloseForm(); Notify(_editing is null ? "تمت إضافة القسم." : "تم الحفظ.", "ok"); _allScoped = new(); await LoadAsync(); }
        else _formError = res.Error ?? "تعذّر الحفظ.";
    }

    private async Task DeleteAsync()
    {
        if (_deleteTarget is null) return;
        _deleting = true;
        var res = await DepartmentsApi.DeleteAsync(_deleteTarget.DepartmentId);
        _deleting = false;
        _deleteTarget = null;
        if (res.Success) { Notify("تم حذف القسم.", "ok"); _allScoped = new(); await LoadAsync(); }
        else Notify(res.Error ?? "تعذّر الحذف.", "err");
    }

    private void Notify(string m, string k) { _notice = m; _noticeKind = k; }

    private sealed class DeptForm
    {
        public int CollegeId { get; set; }
        [Required(ErrorMessage = "اسم القسم مطلوب.")]
        [StringLength(150, MinimumLength = 2, ErrorMessage = "الاسم بين 2 و150 حرفًا.")]
        public string DepartmentName { get; set; } = "";
        public string? Description { get; set; }
        public void Reset() { CollegeId = 0; DepartmentName = ""; Description = null; }
    }
}

<style>
    .row-sub { font-size: .8rem; color: var(--muted); margin-top: .15rem; }
    .hint-inline { font-size: .78rem; color: var(--muted); }
    .txt { height: auto; min-height: 84px; padding: .7rem .85rem; resize: vertical; line-height: 1.6; }
    .spin-btn { width: 14px; height: 14px; border: 2px solid rgba(5,42,42,.3); border-top-color: #052a2a; border-radius: 50%; animation: spin .7s linear infinite; display: inline-block; }
    .ctx-field { display: flex; flex-direction: column; gap: .25rem; min-width: 240px; }
    .ctx-lbl { font-size: .72rem; color: var(--muted); font-family: "Inter", sans-serif; }
    .ctx-field .inp { height: 42px; background: #eef2f7; }
</style>
