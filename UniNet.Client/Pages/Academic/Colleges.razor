@page "/academic/colleges"
@attribute [Authorize(Roles = "Super Admin,UniversityAdmin")]
@using System.ComponentModel.DataAnnotations
@inject CollegeApiService CollegesApi
@inject UniversityApiService UniversitiesApi
@inject ScopeContext Scope

<PageTitle>الكليات · UniNet</PageTitle>

<PageHeader Title="الكليات" Subtitle="إدارة كليات الجامعة ضمن نطاقك.">
    <Actions>
        <button class="btn btn-primary" @onclick="OpenAdd">
            <svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" /></svg>
            كلية جديدة
        </button>
    </Actions>
</PageHeader>

<Alert Message="@_notice" Kind="@_noticeKind" OnClose="() => _notice = null" />

<div class="toolbar">
    <SearchBox Placeholder="ابحث باسم الكلية…" OnSearch="OnSearch" />
    @if (Scope.IsSuperAdmin)
    {
        <div style="min-width:280px">
            <Combobox Items="_uniItems" Value="_filterUniversityId" ValueChanged="OnFilterUniversity"
                      Loading="_uniLoading" Placeholder="تصفية حسب الجامعة (الكل)" />
        </div>
    }
    else
    {
        <div class="ctx-field">
            <span class="ctx-lbl">الجامعة</span>
            <input class="inp" value="@_scopeUniversityName" disabled />
        </div>
    }
</div>

@if (_loading)
{
    <div class="loading"><span class="spin"></span></div>
}
else if (_items is { Count: > 0 })
{
    <div class="table-wrap">
        <table class="data">
            <thead>
                <tr><th style="width:90px">المعرّف</th><th>الكلية</th><th>الجامعة</th><th style="width:150px"></th></tr>
            </thead>
            <tbody>
                @foreach (var c in _items)
                {
                    <tr>
                        <td><span class="badge badge-id">#@c.CollegeId</span></td>
                        <td><strong>@c.CollegeName</strong>@if (!string.IsNullOrEmpty(c.Description)) { <div class="row-sub">@c.Description</div> }</td>
                        <td>@c.UniversityName</td>
                        <td class="actions">
                            <button class="btn btn-ghost btn-sm" @onclick="() => OpenEdit(c)">تعديل</button>
                            <button class="btn btn-danger btn-sm" @onclick="() => _deleteTarget = c">حذف</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <Pager Current="_page" TotalPages="_totalPages" Total="_total" CurrentChanged="ChangePage" />
}
else
{
    <div class="surface empty">
        <svg viewBox="0 0 24 24"><path d="M3 21h18M5 21V7l7-4 7 4v14M9 21v-5h6v5" /></svg>
        <p>لا توجد كليات ضمن نطاقك بعد.</p>
    </div>
}

<!-- إضافة/تعديل -->
<Modal Visible="_formOpen" MaxWidth="520px"
       Title="@(_editing is null ? "كلية جديدة" : "تعديل الكلية")"
       Subtitle="@(_editing is null ? "أضِف كلية إلى الجامعة." : $"تعديل الكلية #{_editing.CollegeId}")"
       OnClose="CloseForm">
    <ChildContent>
        <Alert Message="@_formError" Kind="err" OnClose="() => _formError = null" />
        <EditForm Model="_form" OnValidSubmit="SaveAsync" id="collegeForm">
            <DataAnnotationsValidator />
            <div class="form-grid">
                <div class="form-row">
                    <label class="lbl">الجامعة <span class="req">*</span></label>
                    @if (_editing is not null)
                    {
                        <input class="inp" value="@_editing.UniversityName" disabled />
                        <span class="hint-inline">لا يمكن نقل الكلية بين الجامعات.</span>
                    }
                    else if (Scope.IsSuperAdmin)
                    {
                        <Combobox Items="_uniItems" Value="_form.UniversityId" ValueChanged="v => _form.UniversityId = v"
                                  Loading="_uniLoading" Placeholder="ابحث واختر الجامعة" Disabled="@_saving" />
                    }
                    else
                    {
                        <input class="inp" value="@_scopeUniversityName" disabled />
                        <span class="hint-inline">جامعتك — تُمرَّر تلقائيًا.</span>
                    }
                </div>

                <div class="form-row">
                    <label class="lbl">اسم الكلية <span class="req">*</span></label>
                    <InputText class="inp" @bind-Value="_form.CollegeName" placeholder="مثال: كلية الحاسوب" disabled="@_saving" />
                    <ValidationMessage For="() => _form.CollegeName" />
                </div>

                <div class="form-row">
                    <label class="lbl">الوصف</label>
                    <InputTextArea class="inp txt" @bind-Value="_form.Description" rows="3" disabled="@_saving" />
                </div>
            </div>
        </EditForm>
    </ChildContent>
    <Footer>
        <button class="btn btn-ghost" @onclick="CloseForm" disabled="@_saving">إلغاء</button>
        <button class="btn btn-primary" type="submit" form="collegeForm" disabled="@_saving">
            @if (_saving) { <span class="spin-btn"></span> }
            @(_editing is null ? "إضافة" : "حفظ")
        </button>
    </Footer>
</Modal>

<ConfirmDialog Visible="_deleteTarget is not null"
               Subtitle="@(_deleteTarget is null ? null : $"الكلية #{_deleteTarget.CollegeId}")"
               Message="@($"سيُحذف «{_deleteTarget?.CollegeName}». لا يمكن الحذف إن كانت لها أقسام.")"
               Busy="_deleting" OnConfirm="DeleteAsync" OnCancel="() => _deleteTarget = null" />

@code {
    private List<CollegeDTO>? _items;
    private bool _loading = true;
    private int _page = 1, _pageSize = 10, _totalPages = 1, _total;
    private string _search = "";
    private string? _formError;

    private List<Combobox.ComboItem> _uniItems = new();
    private bool _uniLoading;
    private int _filterUniversityId;
    private string _scopeUniversityName = "—";

    private bool _formOpen, _saving;
    private CollegeDTO? _editing;
    private readonly CollegeForm _form = new();

    private CollegeDTO? _deleteTarget;
    private bool _deleting;

    private string? _notice;
    private string _noticeKind = "ok";

    protected override async Task OnInitializedAsync()
    {
        await Scope.EnsureAsync();

        if (Scope.IsSuperAdmin)
        {
            await LoadUniversitiesAsync();
        }
        else if (Scope.UniversityId is int uid)
        {
            var u = await UniversitiesApi.GetByIdAsync(uid);
            if (u.Success && u.Data is not null) _scopeUniversityName = u.Data.UniversityName;
        }

        await LoadAsync();
    }

    private async Task LoadUniversitiesAsync()
    {
        _uniLoading = true;
        var res = await UniversitiesApi.GetAllAsync(1, 200);
        if (res.Success && res.Data?.Data is not null)
            _uniItems = res.Data.Data.Select(u => new Combobox.ComboItem(u.UniversityId, u.UniversityName)).ToList();
        _uniLoading = false;
    }

    private async Task LoadAsync()
    {
        _loading = true;
        // scope-aware: للمُقيَّد يُطبَّق نطاقه في الخادم؛ للـ SuperAdmin يمكن التصفية بجامعة.
        var res = await CollegesApi.GetPerUniversityAsync(_filterUniversityId, _page, _pageSize, _search);
        if (res.Success && res.Data is not null)
        {
            _items = res.Data.Data ?? new();
            _totalPages = Math.Max(1, res.Data.TotalPages);
            _total = res.Data.TotalRecords;
        }
        else { _items = new(); Notify(res.Error ?? "تعذّر جلب الكليات.", "err"); }
        _loading = false;
    }

    private async Task OnFilterUniversity(int uid) { _filterUniversityId = uid; _page = 1; await LoadAsync(); }
    private async Task OnSearch(string term) { _search = term; _page = 1; await LoadAsync(); }
    private async Task ChangePage(int p) { _page = p; await LoadAsync(); }

    private void OpenAdd()
    {
        _editing = null;
        _form.Reset();
        _formError = null;
        if (!Scope.IsSuperAdmin && Scope.UniversityId is int uid) _form.UniversityId = uid; // تمرير تلقائي
        _formOpen = true;
    }

    private void OpenEdit(CollegeDTO c)
    {
        _editing = c;
        _form.UniversityId = c.UniversityId;
        _form.CollegeName = c.CollegeName;
        _form.Description = c.Description;
        _formError = null;
        _formOpen = true;
    }

    private void CloseForm() { _formOpen = false; _saving = false; _formError = null; }

    private async Task SaveAsync()
    {
        if (_editing is null && _form.UniversityId <= 0) { Notify("اختر الجامعة.", "err"); return; }
        _saving = true;

        ApiResult<CollegeDTO> res;
        if (_editing is null)
        {
            res = await CollegesApi.AddAsync(new AddCollegeDTO
            {
                UniversityId = _form.UniversityId,
                CollegeName = _form.CollegeName.Trim(),
                Description = string.IsNullOrWhiteSpace(_form.Description) ? null : _form.Description!.Trim()
            });
        }
        else
        {
            res = await CollegesApi.UpdateAsync(_editing.CollegeId, new UpdateCollegeDTO
            {
                CollegeName = _form.CollegeName.Trim(),
                Description = string.IsNullOrWhiteSpace(_form.Description) ? null : _form.Description!.Trim()
            });
        }

        _saving = false;
        if (res.Success) { CloseForm(); Notify(_editing is null ? "تمت إضافة الكلية." : "تم الحفظ.", "ok"); await LoadAsync(); }
        else _formError = res.Error ?? "تعذّر الحفظ.";
    }

    private async Task DeleteAsync()
    {
        if (_deleteTarget is null) return;
        _deleting = true;
        var res = await CollegesApi.DeleteAsync(_deleteTarget.CollegeId);
        _deleting = false;
        _deleteTarget = null;
        if (res.Success) { Notify("تم حذف الكلية.", "ok"); await LoadAsync(); }
        else Notify(res.Error ?? "تعذّر الحذف.", "err");
    }

    private void Notify(string m, string k) { _notice = m; _noticeKind = k; }

    private sealed class CollegeForm
    {
        public int UniversityId { get; set; }
        [Required(ErrorMessage = "اسم الكلية مطلوب.")]
        [StringLength(150, MinimumLength = 2, ErrorMessage = "الاسم بين 2 و150 حرفًا.")]
        public string CollegeName { get; set; } = "";
        public string? Description { get; set; }
        public void Reset() { UniversityId = 0; CollegeName = ""; Description = null; }
    }
}

<style>
    .row-sub { font-size: .8rem; color: var(--muted); margin-top: .15rem; }
    .hint-inline { font-size: .78rem; color: var(--muted); }
    .txt { height: auto; min-height: 84px; padding: .7rem .85rem; resize: vertical; line-height: 1.6; }
    .spin-btn { width: 14px; height: 14px; border: 2px solid rgba(5,42,42,.3); border-top-color: #052a2a; border-radius: 50%; animation: spin .7s linear infinite; display: inline-block; }
    .ctx-field { display: flex; flex-direction: column; gap: .25rem; min-width: 240px; }
    .ctx-lbl { font-size: .72rem; color: var(--muted); font-family: "Inter", sans-serif; }
    .ctx-field .inp { height: 42px; background: #eef2f7; }
</style>
