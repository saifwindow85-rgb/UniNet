@page "/academic/batches"
@attribute [Authorize(Roles = "Super Admin,UniversityAdmin,CollegeAdmin,DepartmentAdmin")]
@using System.ComponentModel.DataAnnotations
@inject BatchApiService BatchesApi
@inject DepartmentApiService DepartmentsApi
@inject ScopeLookups Lookups
@inject ScopeContext Scope

<PageTitle>الدفعات · UniNet</PageTitle>

<PageHeader Title="الدفعات" Subtitle="إدارة دفعات القسم ضمن نطاقك.">
    <Actions>
        <button class="btn btn-primary" @onclick="OpenAdd">
            <svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" /></svg>
            دفعة جديدة
        </button>
    </Actions>
</PageHeader>

<Alert Message="@_notice" Kind="@_noticeKind" OnClose="() => _notice = null" />

<div class="toolbar">
    <SearchBox Placeholder="ابحث باسم الدفعة…" OnSearch="OnSearch" />
    @if (Scope.DepartmentId is not null)
    {
        <div class="ctx-field"><span class="ctx-lbl">القسم</span><input class="inp" value="@_scopeDeptName" disabled /></div>
    }
    else
    {
        <div style="min-width:300px">
            <Combobox Items="_deptItems" Value="_filterDeptId" ValueChanged="OnFilterDept"
                      Loading="_deptsLoading" Placeholder="تصفية حسب القسم (الكل)" />
        </div>
    }
</div>

@if (_loading)
{
    <div class="loading"><span class="spin"></span></div>
}
else if (_items is { Count: > 0 })
{
    <div class="table-wrap">
        <table class="data">
            <thead>
                <tr><th style="width:90px">المعرّف</th><th>الدفعة</th><th>القسم</th><th style="width:90px">السنة</th><th style="width:150px"></th></tr>
            </thead>
            <tbody>
                @foreach (var b in _items)
                {
                    <tr>
                        <td><span class="badge badge-id">#@b.BatchId</span></td>
                        <td><strong>@b.BatchName</strong>@if (!string.IsNullOrEmpty(b.Description)) { <div class="row-sub">@b.Description</div> }</td>
                        <td>@b.DepartmentName</td>
                        <td class="mono">@b.BatchYear</td>
                        <td class="actions">
                            <button class="btn btn-ghost btn-sm" @onclick="() => OpenEdit(b)">تعديل</button>
                            <button class="btn btn-danger btn-sm" @onclick="() => _deleteTarget = b">حذف</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <Pager Current="_page" TotalPages="_totalPages" Total="_total" CurrentChanged="ChangePage" />
}
else
{
    <div class="surface empty">
        <svg viewBox="0 0 24 24"><path d="M8 7V3m8 4V3M4 11h16M5 5h14a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Z" /></svg>
        <p>لا توجد دفعات ضمن نطاقك بعد.</p>
    </div>
}

<Modal Visible="_formOpen" MaxWidth="520px"
       Title="@(_editing is null ? "دفعة جديدة" : "تعديل الدفعة")"
       Subtitle="@(_editing is null ? "أضِف دفعة إلى القسم." : $"تعديل الدفعة #{_editing.BatchId}")"
       OnClose="CloseForm">
    <ChildContent>
        <Alert Message="@_formError" Kind="err" OnClose="() => _formError = null" />
        <EditForm Model="_form" OnValidSubmit="SaveAsync" id="batchForm">
            <DataAnnotationsValidator />
            <div class="form-grid">
                @if (_editing is null)
                {
                    <div class="form-row">
                        <label class="lbl">القسم <span class="req">*</span></label>
                        @if (Scope.DepartmentId is not null)
                        {
                            <input class="inp" value="@_scopeDeptName" disabled />
                            <span class="hint-inline">قسمك — يُمرَّر تلقائيًا.</span>
                        }
                        else
                        {
                            <Combobox Items="_deptItems" Value="_form.DepartmentId" ValueChanged="v => _form.DepartmentId = v"
                                      Loading="_deptsLoading" Placeholder="ابحث واختر القسم" Disabled="@_saving" />
                        }
                    </div>
                }
                else
                {
                    <div class="form-row">
                        <label class="lbl">القسم</label>
                        <input class="inp" value="@_editing.DepartmentName" disabled />
                        <span class="hint-inline">لا يمكن نقل الدفعة بين الأقسام.</span>
                    </div>
                }

                <div class="form-row two">
                    <div class="form-row">
                        <label class="lbl">اسم الدفعة <span class="req">*</span></label>
                        <InputText class="inp" @bind-Value="_form.BatchName" placeholder="مثال: دفعة 2025" disabled="@_saving" />
                        <ValidationMessage For="() => _form.BatchName" />
                    </div>
                    <div class="form-row">
                        <label class="lbl">السنة <span class="req">*</span></label>
                        <InputNumber class="inp mono" @bind-Value="_form.BatchYear" disabled="@_saving" />
                        <ValidationMessage For="() => _form.BatchYear" />
                    </div>
                </div>

                <div class="form-row">
                    <label class="lbl">الوصف</label>
                    <InputTextArea class="inp txt" @bind-Value="_form.Description" rows="3" disabled="@_saving" />
                </div>
            </div>
        </EditForm>
    </ChildContent>
    <Footer>
        <button class="btn btn-ghost" @onclick="CloseForm" disabled="@_saving">إلغاء</button>
        <button class="btn btn-primary" type="submit" form="batchForm" disabled="@_saving">
            @if (_saving) { <span class="spin-btn"></span> }
            @(_editing is null ? "إضافة" : "حفظ")
        </button>
    </Footer>
</Modal>

<ConfirmDialog Visible="_deleteTarget is not null"
               Subtitle="@(_deleteTarget is null ? null : $"الدفعة #{_deleteTarget.BatchId}")"
               Message="@($"سيُحذف «{_deleteTarget?.BatchName}». لا يمكن الحذف إن كانت لها شُعَب.")"
               Busy="_deleting" OnConfirm="DeleteAsync" OnCancel="() => _deleteTarget = null" />

@code {
    private List<BatchDTO>? _items;
    private bool _loading = true;
    private int _page = 1, _pageSize = 10, _totalPages = 1, _total;
    private string _search = "";
    private string? _formError;

    private List<Combobox.ComboItem> _deptItems = new();
    private bool _deptsLoading;
    private int _filterDeptId;
    private string _scopeDeptName = "—";

    private bool _formOpen, _saving;
    private BatchDTO? _editing;
    private readonly BatchForm _form = new();

    private BatchDTO? _deleteTarget;
    private bool _deleting;

    private string? _notice;
    private string _noticeKind = "ok";

    protected override async Task OnInitializedAsync()
    {
        await Scope.EnsureAsync();

        if (Scope.DepartmentId is int did)
        {
            var d = await DepartmentsApi.GetByIdAsync(did);
            if (d.Success && d.Data is not null) _scopeDeptName = d.Data.DepartmentName;
        }
        else
        {
            await LoadDeptsAsync();
        }
        await LoadAsync();
    }

    private async Task LoadDeptsAsync()
    {
        _deptsLoading = true;
        _deptItems = await Lookups.DepartmentItemsAsync(); // مُدرك للنطاق: يجمع أقسام كل كليات الجامعة لـ UA
        _deptsLoading = false;
    }

    private async Task LoadAsync()
    {
        _loading = true;
        ApiResult<Contracts.Results.PagedResult<BatchDTO>> res;
        if (Scope.IsSuperAdmin && _filterDeptId <= 0)
            res = await BatchesApi.GetAllAsync(_page, _pageSize, _search);
        else
            res = await BatchesApi.GetPerDepartmentAsync(_filterDeptId, _page, _pageSize, _search);

        if (res.Success && res.Data is not null)
        {
            _items = res.Data.Data ?? new();
            _totalPages = Math.Max(1, res.Data.TotalPages);
            _total = res.Data.TotalRecords;
        }
        else { _items = new(); Notify(res.Error ?? "تعذّر جلب الدفعات.", "err"); }
        _loading = false;
    }

    private async Task OnFilterDept(int did) { _filterDeptId = did; _page = 1; await LoadAsync(); }
    private async Task OnSearch(string term) { _search = term; _page = 1; await LoadAsync(); }
    private async Task ChangePage(int p) { _page = p; await LoadAsync(); }

    private void OpenAdd()
    {
        _editing = null;
        _form.Reset();
        _formError = null;
        if (Scope.DepartmentId is int did) _form.DepartmentId = did;
        _formOpen = true;
    }

    private void OpenEdit(BatchDTO b)
    {
        _editing = b;
        _form.BatchName = b.BatchName;
        _form.BatchYear = b.BatchYear;
        _form.Description = b.Description;
        _formError = null;
        _formOpen = true;
    }

    private void CloseForm() { _formOpen = false; _saving = false; _formError = null; }

    private async Task SaveAsync()
    {
        if (_editing is null && _form.DepartmentId <= 0) { Notify("اختر القسم.", "err"); return; }
        _saving = true;

        ApiResult<BatchDTO> res;
        if (_editing is null)
        {
            res = await BatchesApi.AddAsync(new AddBatchDTO
            {
                DepartmentId = _form.DepartmentId,
                BatchName = _form.BatchName.Trim(),
                BatchYear = _form.BatchYear,
                Description = string.IsNullOrWhiteSpace(_form.Description) ? null : _form.Description!.Trim()
            });
        }
        else
        {
            res = await BatchesApi.UpdateAsync(_editing.BatchId, new UpdateBatchDTO
            {
                BatchName = _form.BatchName.Trim(),
                BatchYear = _form.BatchYear,
                Description = string.IsNullOrWhiteSpace(_form.Description) ? null : _form.Description!.Trim()
            });
        }

        _saving = false;
        if (res.Success) { CloseForm(); Notify(_editing is null ? "تمت إضافة الدفعة." : "تم الحفظ.", "ok"); await LoadAsync(); }
        else _formError = res.Error ?? "تعذّر الحفظ.";
    }

    private async Task DeleteAsync()
    {
        if (_deleteTarget is null) return;
        _deleting = true;
        var res = await BatchesApi.DeleteAsync(_deleteTarget.BatchId);
        _deleting = false;
        _deleteTarget = null;
        if (res.Success) { Notify("تم حذف الدفعة.", "ok"); await LoadAsync(); }
        else Notify(res.Error ?? "تعذّر الحذف.", "err");
    }

    private void Notify(string m, string k) { _notice = m; _noticeKind = k; }

    private sealed class BatchForm
    {
        public int DepartmentId { get; set; }
        [Required(ErrorMessage = "اسم الدفعة مطلوب.")]
        [StringLength(150, MinimumLength = 2, ErrorMessage = "الاسم بين 2 و150 حرفًا.")]
        public string BatchName { get; set; } = "";
        [Range(1900, 2200, ErrorMessage = "سنة غير صالحة.")]
        public int BatchYear { get; set; } = 2025;
        public string? Description { get; set; }
        public void Reset() { DepartmentId = 0; BatchName = ""; BatchYear = 2025; Description = null; }
    }
}

<style>
    .row-sub { font-size: .8rem; color: var(--muted); margin-top: .15rem; }
    .hint-inline { font-size: .78rem; color: var(--muted); }
    .txt { height: auto; min-height: 84px; padding: .7rem .85rem; resize: vertical; line-height: 1.6; }
    .spin-btn { width: 14px; height: 14px; border: 2px solid rgba(5,42,42,.3); border-top-color: #052a2a; border-radius: 50%; animation: spin .7s linear infinite; display: inline-block; }
    .ctx-field { display: flex; flex-direction: column; gap: .25rem; min-width: 240px; }
    .ctx-lbl { font-size: .72rem; color: var(--muted); font-family: "Inter", sans-serif; }
    .ctx-field .inp { height: 42px; background: #eef2f7; }
</style>
