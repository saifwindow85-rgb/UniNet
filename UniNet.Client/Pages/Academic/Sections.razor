@page "/academic/sections"
@attribute [Authorize(Roles = "Super Admin,UniversityAdmin,CollegeAdmin,DepartmentAdmin,BatchAdmin")]
@using System.ComponentModel.DataAnnotations
@inject SectionApiService SectionsApi
@inject BatchApiService BatchesApi
@inject ScopeContext Scope

<PageTitle>الشُعَب · UniNet</PageTitle>

<PageHeader Title="الشُعَب" Subtitle="إدارة شُعَب الدفعة ضمن نطاقك.">
    <Actions>
        <button class="btn btn-primary" @onclick="OpenAdd">
            <svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" /></svg>
            شعبة جديدة
        </button>
    </Actions>
</PageHeader>

<Alert Message="@_notice" Kind="@_noticeKind" OnClose="() => _notice = null" />

<div class="toolbar">
    <SearchBox Placeholder="ابحث باسم الشعبة…" OnSearch="OnSearch" />
    @if (Scope.BatchId is int bctx)
    {
        <div class="ctx-field"><span class="ctx-lbl">الدفعة</span><input class="inp" value="دفعتك · #@bctx" disabled /></div>
    }
    else
    {
        <div style="min-width:300px">
            <Combobox Items="_batchItems" Value="_filterBatchId" ValueChanged="OnFilterBatch"
                      Loading="_batchesLoading" Placeholder="تصفية حسب الدفعة (الكل)" />
        </div>
    }
</div>

@if (_loading)
{
    <div class="loading"><span class="spin"></span></div>
}
else if (_items is { Count: > 0 })
{
    <div class="table-wrap">
        <table class="data">
            <thead>
                <tr><th style="width:90px">المعرّف</th><th>الشعبة</th><th>الدفعة</th><th style="width:150px"></th></tr>
            </thead>
            <tbody>
                @foreach (var s in _items)
                {
                    <tr>
                        <td><span class="badge badge-id">#@s.SectionId</span></td>
                        <td><strong>@s.SectionName</strong></td>
                        <td>@s.BatchName</td>
                        <td class="actions">
                            <button class="btn btn-ghost btn-sm" @onclick="() => OpenEdit(s)">تعديل</button>
                            <button class="btn btn-danger btn-sm" @onclick="() => _deleteTarget = s">حذف</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <Pager Current="_page" TotalPages="_totalPages" Total="_total" CurrentChanged="ChangePage" />
}
else
{
    <div class="surface empty">
        <svg viewBox="0 0 24 24"><path d="M3 3h7v7H3zM14 3h7v7h-7zM14 14h7v7h-7zM3 14h7v7H3z" /></svg>
        <p>لا توجد شُعَب ضمن نطاقك بعد.</p>
    </div>
}

<Modal Visible="_formOpen" MaxWidth="480px"
       Title="@(_editing is null ? "شعبة جديدة" : "تعديل الشعبة")"
       Subtitle="@(_editing is null ? "أضِف شعبة إلى الدفعة." : $"تعديل الشعبة #{_editing.SectionId}")"
       OnClose="CloseForm">
    <ChildContent>
        <Alert Message="@_formError" Kind="err" OnClose="() => _formError = null" />
        <EditForm Model="_form" OnValidSubmit="SaveAsync" id="sectionForm">
            <DataAnnotationsValidator />
            <div class="form-grid">
                @if (_editing is null)
                {
                    <div class="form-row">
                        <label class="lbl">الدفعة <span class="req">*</span></label>
                        @if (Scope.BatchId is int bid)
                        {
                            <input class="inp" value="دفعتك · #@bid" disabled />
                            <span class="hint-inline">دفعتك — تُمرَّر تلقائيًا.</span>
                        }
                        else
                        {
                            <Combobox Items="_batchItems" Value="_form.BatchId" ValueChanged="v => _form.BatchId = v"
                                      Loading="_batchesLoading" Placeholder="ابحث واختر الدفعة" Disabled="@_saving" />
                        }
                    </div>
                }
                else
                {
                    <div class="form-row">
                        <label class="lbl">الدفعة</label>
                        <input class="inp" value="@_editing.BatchName" disabled />
                        <span class="hint-inline">لا يمكن نقل الشعبة بين الدفعات.</span>
                    </div>
                }

                <div class="form-row">
                    <label class="lbl">اسم الشعبة <span class="req">*</span></label>
                    <InputText class="inp" @bind-Value="_form.SectionName" placeholder="مثال: شعبة A" disabled="@_saving" />
                    <ValidationMessage For="() => _form.SectionName" />
                </div>
            </div>
        </EditForm>
    </ChildContent>
    <Footer>
        <button class="btn btn-ghost" @onclick="CloseForm" disabled="@_saving">إلغاء</button>
        <button class="btn btn-primary" type="submit" form="sectionForm" disabled="@_saving">
            @if (_saving) { <span class="spin-btn"></span> }
            @(_editing is null ? "إضافة" : "حفظ")
        </button>
    </Footer>
</Modal>

<ConfirmDialog Visible="_deleteTarget is not null"
               Subtitle="@(_deleteTarget is null ? null : $"الشعبة #{_deleteTarget.SectionId}")"
               Message="@($"ستُحذف «{_deleteTarget?.SectionName}». لا يمكن الحذف إن كان لها طلاب أو مقررات.")"
               Busy="_deleting" OnConfirm="DeleteAsync" OnCancel="() => _deleteTarget = null" />

@code {
    private List<SectionDTO>? _items;
    private bool _loading = true;
    private int _page = 1, _pageSize = 10, _totalPages = 1, _total;
    private string _search = "";
    private string? _formError;

    private List<Combobox.ComboItem> _batchItems = new();
    private bool _batchesLoading;
    private int _filterBatchId;

    private bool _formOpen, _saving;
    private SectionDTO? _editing;
    private readonly SectionForm _form = new();

    private SectionDTO? _deleteTarget;
    private bool _deleting;

    private string? _notice;
    private string _noticeKind = "ok";

    protected override async Task OnInitializedAsync()
    {
        await Scope.EnsureAsync();

        // BatchAdmin: الدفعة مثبّتة (لا combobox). غيره: قائمة دفعات ضمن النطاق.
        if (Scope.BatchId is null)
        {
            await LoadBatchesAsync();
        }
        await LoadAsync();
    }

    private async Task LoadBatchesAsync()
    {
        _batchesLoading = true;
        var res = Scope.IsSuperAdmin
            ? await BatchesApi.GetAllAsync(1, 200)
            : await BatchesApi.GetPerDepartmentAsync(null, 1, 200);
        if (res.Success && res.Data?.Data is not null)
            _batchItems = res.Data.Data
                .Select(b => new Combobox.ComboItem(b.BatchId, b.BatchName, b.DepartmentName)).ToList();
        _batchesLoading = false;
    }

    private async Task LoadAsync()
    {
        _loading = true;
        ApiResult<Contracts.Results.PagedResult<SectionDTO>> res;
        if (Scope.IsSuperAdmin && _filterBatchId <= 0)
            res = await SectionsApi.GetAllAsync(_page, _pageSize, _search);
        else
            res = await SectionsApi.GetPerBatchAsync(_filterBatchId, _page, _pageSize, _search);

        if (res.Success && res.Data is not null)
        {
            _items = res.Data.Data ?? new();
            _totalPages = Math.Max(1, res.Data.TotalPages);
            _total = res.Data.TotalRecords;
        }
        else { _items = new(); Notify(res.Error ?? "تعذّر جلب الشُعَب.", "err"); }
        _loading = false;
    }

    private async Task OnFilterBatch(int bid) { _filterBatchId = bid; _page = 1; await LoadAsync(); }
    private async Task OnSearch(string term) { _search = term; _page = 1; await LoadAsync(); }
    private async Task ChangePage(int p) { _page = p; await LoadAsync(); }

    private void OpenAdd()
    {
        _editing = null;
        _form.Reset();
        _formError = null;
        if (Scope.BatchId is int bid) _form.BatchId = bid;
        _formOpen = true;
    }

    private void OpenEdit(SectionDTO s)
    {
        _editing = s;
        _form.SectionName = s.SectionName;
        _formError = null;
        _formOpen = true;
    }

    private void CloseForm() { _formOpen = false; _saving = false; _formError = null; }

    private async Task SaveAsync()
    {
        if (_editing is null && _form.BatchId <= 0) { Notify("اختر الدفعة.", "err"); return; }
        _saving = true;

        ApiResult<SectionDTO> res;
        if (_editing is null)
            res = await SectionsApi.AddAsync(new AddSectionDTO { BatchId = _form.BatchId, SectionName = _form.SectionName.Trim() });
        else
            res = await SectionsApi.UpdateAsync(_editing.SectionId, new UpdateSectionDTO { SectionName = _form.SectionName.Trim() });

        _saving = false;
        if (res.Success) { CloseForm(); Notify(_editing is null ? "تمت إضافة الشعبة." : "تم الحفظ.", "ok"); await LoadAsync(); }
        else _formError = res.Error ?? "تعذّر الحفظ.";
    }

    private async Task DeleteAsync()
    {
        if (_deleteTarget is null) return;
        _deleting = true;
        var res = await SectionsApi.DeleteAsync(_deleteTarget.SectionId);
        _deleting = false;
        _deleteTarget = null;
        if (res.Success) { Notify("تم حذف الشعبة.", "ok"); await LoadAsync(); }
        else Notify(res.Error ?? "تعذّر الحذف.", "err");
    }

    private void Notify(string m, string k) { _notice = m; _noticeKind = k; }

    private sealed class SectionForm
    {
        public int BatchId { get; set; }
        [Required(ErrorMessage = "اسم الشعبة مطلوب.")]
        [StringLength(100, MinimumLength = 1, ErrorMessage = "الاسم بين 1 و100 حرفًا.")]
        public string SectionName { get; set; } = "";
        public void Reset() { BatchId = 0; SectionName = ""; }
    }
}

<style>
    .hint-inline { font-size: .78rem; color: var(--muted); }
    .spin-btn { width: 14px; height: 14px; border: 2px solid rgba(5,42,42,.3); border-top-color: #052a2a; border-radius: 50%; animation: spin .7s linear infinite; display: inline-block; }
    .ctx-field { display: flex; flex-direction: column; gap: .25rem; min-width: 240px; }
    .ctx-lbl { font-size: .72rem; color: var(--muted); font-family: "Inter", sans-serif; }
    .ctx-field .inp { height: 42px; background: #eef2f7; }
</style>
