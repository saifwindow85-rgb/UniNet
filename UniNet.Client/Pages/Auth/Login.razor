@page "/login"
@layout EmptyLayout
@using System.ComponentModel.DataAnnotations
@inject AuthApiService Auth
@inject NavigationManager Nav

<PageTitle>تسجيل الدخول · UniNet</PageTitle>

<div class="auth">
    <!-- لوحة الهوية -->
    <aside class="brand">
        <svg class="brand-net" viewBox="0 0 600 800" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
            <g class="edges">
                <line x1="90" y1="120" x2="260" y2="210" /><line x1="260" y1="210" x2="150" y2="360" />
                <line x1="260" y1="210" x2="440" y2="160" /><line x1="440" y1="160" x2="520" y2="330" />
                <line x1="150" y1="360" x2="330" y2="430" /><line x1="330" y1="430" x2="520" y2="330" />
                <line x1="330" y1="430" x2="210" y2="600" /><line x1="210" y1="600" x2="420" y2="640" />
                <line x1="520" y1="330" x2="470" y2="560" /><line x1="470" y1="560" x2="420" y2="640" />
                <line x1="90" y1="120" x2="150" y2="360" /><line x1="440" y1="160" x2="330" y2="430" />
            </g>
            <g class="nodes">
                <circle cx="90" cy="120" r="6" /><circle cx="260" cy="210" r="9" /><circle cx="440" cy="160" r="6" />
                <circle cx="150" cy="360" r="7" /><circle cx="330" cy="430" r="11" /><circle cx="520" cy="330" r="8" />
                <circle cx="210" cy="600" r="7" /><circle cx="470" cy="560" r="6" /><circle cx="420" cy="640" r="9" />
            </g>
        </svg>

        <div class="brand-body">
            <div class="brand-mark">
                <span class="brand-glyph">U</span>
                <span class="brand-name">UniNet</span>
            </div>
            <h1 class="brand-title">منظومة إدارة جامعية<br />متعددة المستأجرين</h1>
            <p class="brand-tag">هيكل أكاديمي متكامل، صلاحيات دقيقة حسب النطاق، وإدارة كاملة للمقررات والدرجات — في مكان واحد.</p>

            <ul class="brand-points">
                <li><span class="dot"></span> عزل كامل بين الجامعات والكليات والأقسام</li>
                <li><span class="dot"></span> صلاحيات مبنية على الدور والنطاق</li>
                <li><span class="dot"></span> إدارة الفصول والمواد ودرجات الطلاب</li>
            </ul>
        </div>

        <p class="brand-foot">© 2026 UniNet — لوحة الإدارة</p>
    </aside>

    <!-- لوحة النموذج -->
    <main class="panel">
        <div class="card">
            <header class="card-head">
                <h2>تسجيل الدخول</h2>
                <p>أدخل بياناتك للوصول إلى لوحة الإدارة.</p>
            </header>

            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="alert" role="alert" aria-live="assertive">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 8v5M12 16h.01M10.3 3.7 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.7a2 2 0 0 0-3.4 0Z" /></svg>
                    <span>@_error</span>
                </div>
            }

            <EditForm Model="_model" OnValidSubmit="SubmitAsync">
                <DataAnnotationsValidator />

                <div class="field">
                    <label for="userName">اسم المستخدم</label>
                    <div class="control">
                        <svg class="lead-ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 21a8 8 0 1 0-16 0M12 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z" /></svg>
                        <InputText id="userName" @bind-Value="_model.UserName" class="input" autocomplete="username"
                                   placeholder="مثال: Ahmed.HU" disabled="@_loading" dir="ltr" />
                    </div>
                    <ValidationMessage For="() => _model.UserName" />
                </div>

                <div class="field">
                    <label for="password">كلمة المرور</label>
                    <div class="control">
                        <svg class="lead-ic" viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2" /><path d="M8 11V7a4 4 0 0 1 8 0v4" /></svg>
                        <InputText id="password" type="@(_showPassword ? "text" : "password")" @bind-Value="_model.Password"
                                   class="input" autocomplete="current-password" placeholder="••••••••" disabled="@_loading" dir="ltr" />
                        <button type="button" class="reveal" @onclick="() => _showPassword = !_showPassword"
                                aria-label="@(_showPassword ? "إخفاء كلمة المرور" : "إظهار كلمة المرور")" tabindex="-1" disabled="@_loading">
                            @if (_showPassword)
                            {
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" /><circle cx="12" cy="12" r="3" /></svg>
                            }
                            else
                            {
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 3l18 18M10.6 10.6a3 3 0 0 0 4.2 4.2M9.9 4.6A9.8 9.8 0 0 1 12 5c6.5 0 10 7 10 7a17 17 0 0 1-3.1 3.9M6.1 6.2A17 17 0 0 0 2 12s3.5 7 10 7a9.7 9.7 0 0 0 3-.5" /></svg>
                            }
                        </button>
                    </div>
                    <ValidationMessage For="() => _model.Password" />
                </div>

                <button type="submit" class="submit" disabled="@_loading">
                    @if (_loading)
                    {
                        <span class="spinner" aria-hidden="true"></span>
                        <span>جارٍ الدخول…</span>
                    }
                    else
                    {
                        <span>دخول</span>
                        <svg viewBox="0 0 24 24" aria-hidden="true" class="arrow"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                    }
                </button>
            </EditForm>

            <p class="hint">الوصول مقيّد بموظفي الجامعة المصرّح لهم.</p>
        </div>
    </main>
</div>

@code {
    private readonly LoginModel _model = new();
    private bool _loading;
    private bool _showPassword;
    private string? _error;

    private async Task SubmitAsync()
    {
        _loading = true;
        _error = null;

        var result = await Auth.LoginAsync(new LoginRequest
        {
            UserName = _model.UserName,
            Password = _model.Password
        });

        _loading = false;

        if (result.Success)
        {
            Nav.NavigateTo(ResolveReturnUrl());
            return;
        }

        _error = result.Error;
    }

    private string ResolveReturnUrl()
    {
        var query = new Uri(Nav.Uri).Query;
        if (query.StartsWith('?'))
            query = query[1..];

        foreach (var pair in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var parts = pair.Split('=', 2);
            if (parts.Length == 2 && parts[0] == "returnUrl" && !string.IsNullOrWhiteSpace(parts[1]))
                return Uri.UnescapeDataString(parts[1]);
        }
        return "/";
    }

    private sealed class LoginModel
    {
        [Required(ErrorMessage = "اسم المستخدم مطلوب.")]
        public string UserName { get; set; } = string.Empty;

        [Required(ErrorMessage = "كلمة المرور مطلوبة.")]
        [MinLength(6, ErrorMessage = "كلمة المرور 6 أحرف على الأقل.")]
        public string Password { get; set; } = string.Empty;
    }
}
