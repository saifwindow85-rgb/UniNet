@inject NavigationManager Nav

<nav class="sidebar @Class @(Collapsed ? "is-collapsed" : "")">
    <div class="brand" @onclick='() => Go("/")'>
        <span class="glyph">U</span>
        <div class="brand-text">
            <span class="name">UniNet</span>
            <span class="sub">لوحة الإدارة</span>
        </div>
    </div>

    <div class="scroll">
        <NavLink class="link" href="/" Match="NavLinkMatch.All" @onclick="OnNavigate">
            <svg viewBox="0 0 24 24"><path d="M3 10.5 12 3l9 7.5M5 9.5V21h14V9.5M9.5 21v-6h5v6" /></svg>
            <span>الرئيسية</span>
        </NavLink>

        <AuthorizeView Roles="Super Admin">
            <section class="group">
                <button class="group-head" @onclick="() => _identityOpen = !_identityOpen">
                    <span class="gh-main">
                        <svg viewBox="0 0 24 24"><path d="M12 2 4 5v6c0 5 3.5 8.5 8 11 4.5-2.5 8-6 8-11V5l-8-3Z" /></svg>
                        <span>الهوية</span>
                    </span>
                    <svg class="chev @(_identityOpen ? "up" : "")" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6" /></svg>
                </button>

                <div class="group-body @(_identityOpen ? "open" : "")">
                    <NavLink class="sublink" href="/identity/roles" @onclick="OnNavigate">
                        <span class="sub-ic">
                            @* الأدوار: مفتاح — يرمز للصلاحيات *@
                            <svg viewBox="0 0 24 24"><circle cx="7.5" cy="15.5" r="4.5" /><path d="M10.7 12.3 20 3M16.5 6.5 19 9M14.5 8.5 16.5 10.5" /></svg>
                        </span>
                        <span>الأدوار</span>
                    </NavLink>
                    <NavLink class="sublink" href="/identity/users" @onclick="OnNavigate">
                        <span class="sub-ic">
                            @* المستخدمون: شخص *@
                            <svg viewBox="0 0 24 24"><path d="M20 21a8 8 0 1 0-16 0" /><circle cx="12" cy="8" r="4" /></svg>
                        </span>
                        <span>المستخدمون</span>
                    </NavLink>
                    <NavLink class="sublink" href="/identity/user-roles" @onclick="OnNavigate">
                        <span class="sub-ic">
                            @* أدوار المستخدمين: شخص مع علامة صح — يرمز للإسناد *@
                            <svg viewBox="0 0 24 24"><path d="M16 21v-1.5a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4V21" /><circle cx="9" cy="7" r="4" /><path d="m16 11 2.2 2.2L22 9.5" /></svg>
                        </span>
                        <span>أدوار المستخدمين</span>
                    </NavLink>
                </div>
            </section>
        </AuthorizeView>
    </div>

    <div class="foot mono">© 2026 UniNet</div>
</nav>

@code {
    [Parameter] public string? Class { get; set; }
    [Parameter] public bool Collapsed { get; set; }
    [Parameter] public EventCallback OnNavigate { get; set; }

    private bool _identityOpen = true;

    private void Go(string url)
    {
        Nav.NavigateTo(url);
        OnNavigate.InvokeAsync();
    }
}
