@inherits LayoutComponentBase
@inject AuthApiService Auth
@inject NavigationManager Nav

<div class="layout @(_collapsed ? "collapsed" : "")">
    <NavMenu OnNavigate="CloseNav" Class="@(_navOpen ? "open" : "")" Collapsed="_collapsed" />
    @if (_navOpen)
    {
        <div class="nav-scrim" @onclick="CloseNav"></div>
    }

    <div class="main">
        <header class="topbar">
            <button class="burger" @onclick="() => _navOpen = !_navOpen" aria-label="القائمة">
                <svg viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
            </button>

            <button class="collapse-btn" @onclick="() => _collapsed = !_collapsed"
                    title="@(_collapsed ? "إظهار الشريط الجانبي" : "إخفاء الشريط الجانبي")"
                    aria-label="@(_collapsed ? "إظهار الشريط الجانبي" : "إخفاء الشريط الجانبي")">
                @if (_collapsed)
                {
                    <svg viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
                }
                else
                {
                    <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2" /><path d="M15 4v16M18.5 9.5 16 12l2.5 2.5" /></svg>
                }
            </button>

            <div class="crumb">لوحة إدارة UniNet</div>

            <AuthorizeView>
                <Authorized>
                    <div class="user">
                        <div class="who">
                            <span class="uname">@context.User.Identity?.Name</span>
                            <span class="urole">@RoleOf(context)</span>
                        </div>
                        <div class="avatar">@InitialOf(context)</div>
                        <button class="btn btn-danger btn-sm" @onclick="LogoutAsync">
                            <svg viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9" /></svg>
                            خروج
                        </button>
                    </div>
                </Authorized>
            </AuthorizeView>
        </header>

        <main class="content">
            @Body
        </main>
    </div>
</div>

@code {
    private bool _navOpen;
    private bool _collapsed;

    private void CloseNav() => _navOpen = false;

    private async Task LogoutAsync()
    {
        await Auth.LogoutAsync();
        Nav.NavigateTo("/login");
    }

    private static string RoleOf(AuthenticationState state) =>
        state.User.FindFirst("http://schemas.microsoft.com/ws/2008/06/identity/claims/role")?.Value
        ?? state.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value
        ?? "مستخدم";

    private static string InitialOf(AuthenticationState state)
    {
        var name = state.User.Identity?.Name;
        return string.IsNullOrWhiteSpace(name) ? "؟" : name.Trim()[..1].ToUpperInvariant();
    }
}
