@inherits LayoutComponentBase
@inject AuthApiService Auth
@inject NavigationManager Nav

<div class="shell">
    <header class="topbar">
        <div class="brand">
            <span class="glyph">U</span>
            <span class="name">UniNet</span>
        </div>

        <AuthorizeView>
            <Authorized>
                <div class="user">
                    <div class="who">
                        <span class="uname">@context.User.Identity?.Name</span>
                        <span class="urole">@RoleOf(context)</span>
                    </div>
                    <div class="avatar">@InitialOf(context)</div>
                    <button class="logout" @onclick="LogoutAsync" title="تسجيل الخروج">خروج</button>
                </div>
            </Authorized>
        </AuthorizeView>
    </header>

    <main class="content">
        @Body
    </main>
</div>

@code {
    private async Task LogoutAsync()
    {
        await Auth.LogoutAsync();
        Nav.NavigateTo("/login");
    }

    private static string RoleOf(AuthenticationState state) =>
        state.User.FindFirst("http://schemas.microsoft.com/ws/2008/06/identity/claims/role")?.Value
        ?? state.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value
        ?? "مستخدم";

    private static string InitialOf(AuthenticationState state)
    {
        var name = state.User.Identity?.Name;
        return string.IsNullOrWhiteSpace(name) ? "؟" : name.Trim()[..1].ToUpperInvariant();
    }
}
