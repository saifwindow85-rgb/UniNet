                {
                    UserId = token.UserId,
                    UserName = token.UserName,
                    UniversityId = token.UniversityId,
                    UserRoles = userRoles,
                };
            }
            if(typeResult.StudentAuthorizationInfo.BatchId != null)
            {
                return new TokenUserInfoDTO
                {
