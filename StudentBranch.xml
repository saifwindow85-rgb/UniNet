                    UniversityId = token.UniversityId,
                    UserRoles = userRoles,
                    BatchId = typeResult.StudentAuthorizationInfo?.BatchId,
                    DepartmentId = typeResult.StudentAuthorizationInfo?.DepartmentId,
                    CollegeId = typeResult.StudentAuthorizationInfo?.CollegeId,
