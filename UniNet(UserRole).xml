            builder.HasOne(b => b.Department).WithMany(d => d.Batches)
                .HasForeignKey(b => b.DepartmentId).IsRequired().OnDelete(DeleteBehavior.Restrict);

            builder.ToTable("Batches");

            builder.HasData(SeedData.GetBatches());
        }
    }
